#!/usr/bin/env bash
#
# Automatically generates a Git post-merge hook inside the repository's
# internal metadata directory (~/.config/vcsh/repo.d/<repo>.git/hooks/).

GIT_DIR="$HOME/.config/vcsh/repo.d/${VCSH_REPO_NAME}.git"
HOOKS_DIR="$GIT_DIR/hooks"
POST_MERGE_HOOK="$HOOKS_DIR/post-merge"
TRACKED_SPARSE="$HOME/.config/${VCSH_REPO_NAME}/sparse-checkout"

# Ensure internal Git hooks directory exists
mkdir -p "$HOOKS_DIR"

echo "[post-clone] Generating post-merge hook for '$VCSH_REPO_NAME'..."

# Write the post-merge executable script directly into the repo's Git hooks
cat <<EOF >"$POST_MERGE_HOOK"
#!/usr/bin/env bash
# Auto-generated by vcsh post-clone hook
# Syncs local sparse-checkout configuration when tracked rules update.

TRACKED_SPARSE="$HOME/.config/bash/sparse-checkout"
LOCAL_SPARSE="$HOME/.config/vcsh/repo.d/bash.git/info/sparse-checkout"

if [ -f "$TRACKED_SPARSE" ]; then
	if ! cmp -s "$TRACKED_SPARSE" "$LOCAL_SPARSE"; then
		echo "[post-merge hook] Updating local sparse-checkout rules..."
		cp "$TRACKED_SPARSE" "$LOCAL_SPARSE"
		vcsh run bash git read-tree -mu HEAD
	fi
fi
EOF

# Make the post-merge hook executable
chmod +x "$POST_MERGE_HOOK"

# Verification step
if [ -x "$POST_MERGE_HOOK" ]; then
	echo "[post-clone] Successfully installed Git post-merge hook at $POST_MERGE_HOOK"
else
	echo "[post-clone] Error: Failed to make $POST_MERGE_HOOK executable" >&2
fi
